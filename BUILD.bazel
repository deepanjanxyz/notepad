# Root package: shared Kotlin toolchain, the Compose compiler plugin, and the
# Android ABI platforms used for release builds.

load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain", "kt_compiler_plugin")

# Java 21, same as the old Gradle toolchain.
define_kt_toolchain(
    name = "kotlin_toolchain",
    jvm_target = "21",
)

# Jetpack Compose is enabled by attaching this compiler plugin to a target's
# `plugins` attribute — there is no boolean "compose = true" in Bazel. The
# plugin version has to match the Kotlin version (2.4.21), not the Compose BOM.
kt_compiler_plugin(
    name = "jetpack_compose_compiler_plugin",
    id = "androidx.compose.compiler.plugins.kotlin",
    target_embedded_compiler = True,
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:org_jetbrains_kotlin_kotlin_compose_compiler_plugin_embeddable",
    ],
)

# --- ABI platforms -----------------------------------------------------------------
# One platform per ABI. `bazel build //app:app --config=release` fans out across
# all four; building a single `--android_platforms=//:arm64_v8a` gives you just
# that one APK.

platform(
    name = "arm64_v8a",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:android",
    ],
)

platform(
    name = "armeabi_v7a",
    constraint_values = [
        "@platforms//cpu:armv7",
        "@platforms//os:android",
    ],
)

platform(
    name = "x86",
    constraint_values = [
        "@platforms//cpu:x86_32",
        "@platforms//os:android",
    ],
)

platform(
    name = "x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:android",
    ],
)
