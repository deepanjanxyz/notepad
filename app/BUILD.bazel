load("@rules_android//android:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library", "kt_android_local_test")
load("//:version.bzl", "VERSION_CODE", "VERSION_NAME")

kt_android_library(
    name = "app_lib",
    srcs = glob(["src/main/java/**/*.kt"]),
    custom_package = "com.deepanjanxyz.notepad",
    manifest = "src/main/AndroidManifest.xml",
    plugins = ["//:jetpack_compose_compiler_plugin"],
    resource_files = glob(["src/main/res/**"]),
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "//data",
        "//domain",
        "//features",
        "@maven//:androidx_activity_activity_compose",
        "@maven//:androidx_biometric_biometric",
        "@maven//:androidx_compose_foundation_foundation",
        "@maven//:androidx_compose_material3_material3",
        "@maven//:androidx_compose_material_material_icons_extended",
        "@maven//:androidx_compose_runtime_runtime",
        "@maven//:androidx_compose_ui_ui",
        "@maven//:androidx_compose_ui_ui_graphics",
        "@maven//:androidx_compose_ui_ui_tooling_preview",
        "@maven//:androidx_core_core_ktx",
        "@maven//:androidx_core_core_splashscreen",
        "@maven//:androidx_fragment_fragment_ktx",
        "@maven//:androidx_lifecycle_lifecycle_runtime_compose",
        "@maven//:androidx_lifecycle_lifecycle_runtime_ktx",
        "@maven//:androidx_lifecycle_lifecycle_viewmodel_compose",
        "@maven//:androidx_work_work_runtime_ktx",
    ],
)

android_binary(
    name = "app",
    custom_package = "com.deepanjanxyz.notepad",
    manifest = "src/main/AndroidManifest.xml",
    manifest_values = {
        "applicationId": "com.deepanjanxyz.notepad",
        "minSdkVersion": "24",
        "targetSdkVersion": "37",
        "versionCode": str(VERSION_CODE),
        "versionName": VERSION_NAME,
    },
    multidex = "native",
    proguard_specs = ["proguard-rules.pro"],
    shrink_resources = True,
    deps = [":app_lib"],
)

kt_android_local_test(
    name = "app_test",
    srcs = glob(["src/test/java/**/*.kt"]),
    manifest = "src/main/AndroidManifest.xml",
    resource_files = glob(["src/main/res/**"]),
    deps = [
        ":app_lib",
        "@maven//:junit_junit",
    ],
)
