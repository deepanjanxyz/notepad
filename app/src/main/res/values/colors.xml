<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App icon / launcher background colours. -->
    <color name="purple_500">#004BA0</color>
    <color name="purple_700">#002171</color>
    <color name="teal_200">#03DAC5</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      System-bar scrims. The Compose surface is edge-to-edge, so these only
      matter while a system bar is drawn over app content. They follow the theme
      background instead of being forced transparent, which previously left
      light-theme status bar icons stranded on a light background.
    -->
    <color name="system_bar_scrim_light">#F8F9FF</color>
    <color name="system_bar_scrim_dark">#0E1116</color>
</resources>
